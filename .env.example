# Archivo de ejemplo. Copiar como backend/.env y completar.
# NUNCA subir el .env real: contiene contraseñas y claves (el repositorio es público).
# Si la contraseña tiene símbolos (@ / :), usar una clave solo con letras y números.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/ciclo

# Mínimo 32 caracteres. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave